# =============================================================================
# CarbonThreat Enterprise — Environment Configuration Template
#
# HOW TO USE:
#   cp .env.example .env
#   # then replace every GENERATE_* value using the commands shown inline
#
# RULES:
#   • .env is in .gitignore — NEVER commit it
#   • Never reuse keys across environments (dev / staging / prod)
#   • Rotate all keys immediately if any are accidentally exposed
# =============================================================================

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
NODE_ENV=production          # development | test | production
PORT=3001                    # backend API port
LOG_LEVEL=info               # error | warn | info | debug

# FQDN — used in SAML metadata and cookie domain (required in production)
APP_HOSTNAME=carbonthreat.example.com
APP_USE_TLS=true
APP_TLS_CERT_PATH=/etc/ssl/certs/fullchain.pem
APP_TLS_KEY_PATH=/etc/ssl/certs/privkey.pem

# -----------------------------------------------------------------------------
# PostgreSQL — choose ONE of the two forms below
# -----------------------------------------------------------------------------

# Form A: single connection string (recommended for Docker / cloud deployments)
# Generate password: openssl rand -base64 24
DATABASE_URL=postgres://carbonthreat_user:GENERATE_openssl_rand_base64_24@localhost:5432/carbonthreat

# Form B: individual variables (used when DATABASE_URL is absent)
# DB_HOST=localhost
# DB_PORT=5432
DB_USER=carbonthreat_user
DB_PASSWORD=GENERATE_openssl_rand_base64_24
DB_NAME=carbonthreat

# -----------------------------------------------------------------------------
# JWT Signing — minimum 32 characters, 8+ unique chars
# Generate: openssl rand -base64 48
# REQUIRED — startup will abort if these are weak or missing
# -----------------------------------------------------------------------------
ENCRYPTION_JWT_SIGNING_KEY=GENERATE_openssl_rand_base64_48
ENCRYPTION_JWT_REFRESH_SIGNING_KEY=GENERATE_openssl_rand_base64_48_different_value

# -----------------------------------------------------------------------------
# Model Encryption — AES-256-GCM key (exactly 64 hex chars = 32 bytes)
# Generate: openssl rand -hex 32
# REQUIRED for PostgreSQL model storage
# -----------------------------------------------------------------------------
ENCRYPTION_KEY=GENERATE_openssl_rand_hex_32

# -----------------------------------------------------------------------------
# Legacy token encryption (existing td.server OAuth mechanism)
# Value must be exactly 32 characters
# Generate: openssl rand -base64 24 | head -c 32
# -----------------------------------------------------------------------------
ENCRYPTION_KEYS='[{"isPrimary": true, "id": 0, "value": "GENERATE_32_chars_exactly_________"}]'

# -----------------------------------------------------------------------------
# STRIDE Engine — AI-powered threat analysis (internal microservice)
# The token must match between carbonthreat and stride-engine containers.
# Generate: openssl rand -hex 32
# STRIDE_ENGINE_URL is set automatically in docker-compose (internal network).
# -----------------------------------------------------------------------------
STRIDE_ENGINE_TOKEN=GENERATE_openssl_rand_hex_32

# LLM Provider Keys — only needed inside stride-engine container.
# Set only the keys for providers you intend to use.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
MISTRAL_API_KEY=
GROQ_API_KEY=
OLLAMA_ENDPOINT=http://host.docker.internal:11434
OLLAMA_TIMEOUT=300
LM_STUDIO_ENDPOINT=http://host.docker.internal:1234

# -----------------------------------------------------------------------------
# SSO / SAML (optional — leave blank to disable)
# Register your app in Azure AD / Okta / Google Workspace, then fill these in.
# -----------------------------------------------------------------------------
SAML_ENTRY_POINT=
SAML_ISSUER=
SAML_CERT=
SSO_REDIRECT_URL=https://carbonthreat.example.com/auth/sso/return

# -----------------------------------------------------------------------------
# GitHub OAuth (for threat model storage in GitHub repos — original feature)
# -----------------------------------------------------------------------------
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_SCOPE=public_repo

# -----------------------------------------------------------------------------
# GitLab OAuth
# -----------------------------------------------------------------------------
GITLAB_CLIENT_ID=
GITLAB_CLIENT_SECRET=
GITLAB_SCOPE=read_user read_repository write_repository profile read_api api
GITLAB_REDIRECT_URI=https://carbonthreat.example.com/api/oauth/return

# -----------------------------------------------------------------------------
# Bitbucket OAuth
# -----------------------------------------------------------------------------
BITBUCKET_CLIENT_ID=
BITBUCKET_CLIENT_SECRET=
BITBUCKET_SCOPE=repository:write
BITBUCKET_WORKSPACE=

# -----------------------------------------------------------------------------
# Google Drive OAuth
# -----------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_SCOPE=openid email profile
GOOGLE_REDIRECT_URI=https://carbonthreat.example.com/api/oauth/return
